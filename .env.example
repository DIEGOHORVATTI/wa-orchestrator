# The ONLY phone number this bot will ever read messages from or reply to.
# Digits only, with country code, no "+" or spaces (e.g. 5511999999999).
WA_ALLOWED_NUMBER=

# Optional overrides — sane defaults are used if omitted.
# Port the orchestrator's own webhook HTTP server listens on.
# WA_ORCH_PORT=8090

# Base URL of the whatsapp-mcp bridge's REST API (whatsapp-bridge/main.go).
# WA_BRIDGE_URL=http://127.0.0.1:8080

# Path to the whatsapp-mcp bridge checkout (used to read store/.bridge-token).
# WA_BRIDGE_DIR=/home/you/whatsapp-mcp/whatsapp-bridge

# Working directory opencode runs in for every message (--dir flag).
# WA_OPENCODE_CWD=/home/you/some-project

# Base URL of a warm `opencode serve` instance (see README) that the
# orchestrator attaches to instead of cold-starting a full opencode process
# per message.
# WA_OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Path/name of the opencode binary to invoke.
# WA_OPENCODE_BIN=opencode
